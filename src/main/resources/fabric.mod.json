{
  "schemaVersion": 1,
  "id": "xaeros-biome-filter",
  "version": "${version}",
  "name": "Xaero's Biome Filter",
  "description": "Adds instant show-selected and hide-selected biome filtering to Xaero's World Map, with optional Xaero's Minimap support.",
  "authors": [
    "deanxbox"
  ],
  "license": "MIT",
  "icon": "assets/xaeros-biome-filter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "deanxbox.xaerosbiomefilter.XaerosBiomeFilterClient"
    ]
  },
  "mixins": [
    "xaeros-biome-filter.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "xaeroworldmap": ">=1.46.0"
  },
  "suggests": {
    "xaerominimap": ">=26.5.0"
  }
}
